# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=artspace
POSTGRES_USER=artspace
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql://artspace:change_me_in_production@postgres:5432/artspace

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=replace_with_a_long_random_string_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ─── Bucket / Object Storage (S3-compatible) ─────────────────────────────────
STORAGE_BUCKET_URL=https://s3.amazonaws.com
STORAGE_BUCKET_NAME=artspace-media
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_URL=https://artspace-media.s3.amazonaws.com

# ─── App ─────────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
VITE_API_URL=http://localhost:8000
